{
  "name": "pm-saas-root",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-Tenant Project Management SaaS (BEE-II Evaluation)",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "seed": "npm run seed --prefix backend",
    "db:clear": "npm run db:clear --prefix backend",
    "test:isolation": "npm run test:isolation --prefix backend",
    "test:auth": "npm run test:auth --prefix backend",
    "install:all": "npm install && npm install --prefix backend && npm install --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
