PORT=5000
NODE_ENV=development
# MongoDB URI - leave empty to automatically spin up mongodb-memory-server for local dev/testing
MONGO_URI=
JWT_SECRET=supersecret_jwt_key_for_multitenant_saas_evaluation_2026
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Brevo HTTPS Email API (works on Render Free tier & local dev)
BREVO_API_KEY=
EMAIL_FROM=

# Upstash Redis (optional in local dev: falls back to in-memory socket adapter & cache)
REDIS_URL=

# Cloudinary for task attachments (optional in local dev: falls back to server/uploads/)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Observability (Pino & Sentry)
LOG_LEVEL=info
SENTRY_DSN=
