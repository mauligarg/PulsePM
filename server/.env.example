PORT=5000
NODE_ENV=development
# MongoDB URI - leave empty to automatically spin up mongodb-memory-server for local dev/testing
MONGO_URI=
JWT_SECRET=supersecret_jwt_key_for_multitenant_saas_evaluation_2026
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Nodemailer / SMTP config (optional: if omitted, invite links are logged to console & returned in dev API response)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@saas-pm.local
